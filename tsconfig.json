{
  "compilerOptions": {
    "strict": true,
    "outDir": "bin",
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "sourceMap": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["index.ts", "scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
